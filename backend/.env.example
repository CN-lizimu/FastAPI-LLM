# Application
APP_ENV=development
DEBUG=false
APP_LOG_LEVEL=INFO
RAG_DEBUG_LOG=false
RAG_DEBUG_MAX_CHARS=800

# Database. Keep credentials out of source control.
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@127.0.0.1:3306/news_app?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Browser origins, comma-separated
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# DashScope / Qwen
DASHSCOPE_API_KEY=replace-with-your-key
LLM_MODEL_ID=qwen3.6-flash
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_ENDPOINT=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=4
LLM_CONCURRENCY_WAIT_TIMEOUT_SECONDS=5

# RAG / Chroma
CHROMA_COLLECTION_NAME=news_rag_cosine_candidate
CHROMA_LEGACY_COLLECTION_NAME=news_rag
CHROMA_COSINE_CANDIDATE_COLLECTION_NAME=news_rag_cosine_candidate
CHROMA_PERSIST_DIR=chroma_db
CHROMA_DISTANCE_METRIC=cosine
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5
RAG_RETRIEVAL_TIMEOUT_SECONDS=30
RAG_DB_FETCH_BATCH_SIZE=5
RAG_WRITE_BATCH_SIZE=5
RAG_ADD_RETRY_ATTEMPTS=3
RAG_ADD_RETRY_DELAY_SECONDS=2
RAG_START_OFFSET=0
RAG_RECREATE_COLLECTION=false
RAG_DRY_RUN=false
CHAT_HISTORY_LIMIT=10

# JWT. Generate a long random value for every environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=fastapi-llm
JWT_AUDIENCE=fastapi-llm-users
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
